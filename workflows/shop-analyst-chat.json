        "messages": {
          "messageValues": [
            {
              "message": "You sort messages sent to the analytics assistant of an online coffee and tea shop.\nThe assistant answers questions about the shop's own data: sales and revenue, orders, products and categories,\ncustomers and their countries, reviews and ratings, refunds and cancellations, sales channels.\n\nReply with ONE JSON object and nothing else:\n{\"intent\": \"data\" | \"smalltalk\" | \"out_of_scope\", \"reply\": \"<text>\"}\n\n- data: the message asks something that the shop's data can answer. reply = \"\".\n- smalltalk: greetings, thanks, \"what can you do\". reply = one friendly sentence that says what you can answer.\n- out_of_scope: anything else (general knowledge, coding, other companies, advice). reply = one polite sentence.\n"
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        -1160,
        200
      ],
      "id": "cc662a10-aa79-570c-9ce1-d89d451b3829",
      "name": "Guard - Classify question",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// The model is asked for JSON, but small models wrap it in prose or code fences: dig it out, default to \"data\".\nconst text = String($json.text ?? '');\nlet parsed = {};\nconst match = text.match(/\\{[\\s\\S]*\\}/);\ntry { parsed = match ? JSON.parse(match[0]) : {}; } catch (e) { parsed = {}; }\nconst allowed = ['data', 'smalltalk', 'out_of_scope'];\nconst intent = allowed.includes(parsed.intent) ? parsed.intent : 'data';\nreturn [{ json: { intent, reply: String(parsed.reply ?? '').trim(),\n                  question: $('Config - Request').first().json.question } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -860,
        200
      ],
      "id": "60d995b0-1c41-5471-afbc-37a8b6946d2d",
